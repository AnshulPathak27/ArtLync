# Database
# Local development (SQLite)
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL - Neon, Supabase, etc.)
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Authentication
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Storage
# Local development
STORAGE_DRIVER="local"
# Production (S3-compatible: Cloudflare R2, AWS S3, Supabase Storage)
# STORAGE_DRIVER="s3"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_BUCKET="your-bucket-name"
# S3_ACCESS_KEY_ID="your-access-key-id"
# S3_SECRET_ACCESS_KEY="your-secret-access-key"
# S3_REGION="auto"

# Optional: Local LLM for AI Brief Builder (Ollama, llama.cpp, etc.)
# LLM_ENDPOINT="http://localhost:11434/v1"
# LLM_MODEL="llama3"

# Optional: External services
# SENTRY_DSN="https://xxx@sentry.io/xxx"
# ANALYTICS_ID="G-XXXXXXXXXX"